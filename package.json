{
  "name": "guild",
  "private": false,
  "version": "0.2.0",
  "license": "MIT",
  "description": "A local guild of adventurers. @mention the one you actually want. Not another omniscient chat.",
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @guild/daemon dev",
    "dev:desktop": "pnpm --filter @guild/desktop dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @guild/daemon test"
  }
}
